# LOCAL dev
PORT=8000
# Same Postgres as the monorepo (checkpointer tables are created by the agent on boot)
DATABASE_URL="postgresql://kosply:kosply@localhost:5432/kosply_dev?schema=public"
# Kosply server (tools call its internal HTTP API, never the DB directly)
KOSPLY_SERVER_URL="http://localhost:3000"
# Model id, init_chat_model format, e.g. openai:gpt-4o-mini
AI_MODEL="openai:gpt-4o-mini"
# Liveness guards (per-process)
AI_RATE_LIMIT_PER_MIN=60
AI_MAX_BODY_BYTES=1000000
AI_MAX_INFLIGHT=50
AI_MODEL_TIMEOUT_S=120
AI_QUEUE_TIMEOUT_S=5
# Provider credentials (read by the model client from env)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""
