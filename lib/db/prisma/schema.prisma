/**
 * @title Kosply database schema
 * @notice Single source of truth for Postgres tables.
 * @dev Student second-hand marketplace. Category is still String? (blank)
 * @dev for now, later a FK to a Category model. KTM images are never public,
 * @dev only admins read them for seller verification.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// @notice Account role. BUYER = regular customer, SELLER = verified student,
/// @notice ADMIN = dashboard operator, SUPER_ADMIN = manages admins.
enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

/// @notice Seller verification status decided by an admin.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// @notice Admin decision on an ID verification application. NONE = undecided.
enum VerificationAction {
  NONE
  APPROVE
  REJECT
}

/// @notice Product catalog status.
enum ProductStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

/// @notice Catalog event recorded for seller analytics.
/// @dev IMPRESSION = the listing was shown in a feed/search.
/// @dev CLICK = a buyer opened the product detail. CTR = CLICK / IMPRESSION.
enum ProductEventType {
  IMPRESSION
  CLICK
}

/// @notice COD chat message type (buyer <-> seller directly, no payment gateway).
enum MessageType {
  TEXT
  IMAGE
  LOCATION
  SYSTEM
}

/// @notice Support ticket status. ACTIVE = being handled, CLOSED = done/inactive.
enum SupportTicketStatus {
  ACTIVE
  CLOSED
}

/// @notice Support ticket category (dashboard filter).
enum SupportTicketCategory {
  AKUN
  PRODUK
  CHAT
  VERIFIKASI
  LAPORAN
  LAINNYA
}

/// @notice Catalog fraud report category (Report button options in the UI).
enum ReportCategory {
  PENIPUAN
  BARANG_PALSU
  BARANG_TIDAK_SESUAI
  HARGA_MENYESATKAN
  KONTEN_TIDAK_PANTAS
  SPAM
  LAINNYA
}

/// @notice Report status. PENDING = arrived, IN_REVIEW = handled by admin, RESOLVED/REJECTED = done.
enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

/// @notice Admin action on a report: warn, delete the listing, or ban the user.
enum ReportAction {
  NONE
  WARNING
  DELETE_PRODUCT
  BAN_USER
}

/// @notice Base account. Buyer vs seller is distinguished by the SellerVerification relation + role field.
model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  username              String               @unique
  name                  String
  passwordHash       String
  googleId           String?            @unique /// Google sub (direct auth link)
  appleId            String?            @unique /// Apple sub (direct auth link)
  universitas           String
  programStudi          String
  bio                   String?              @db.Text /// seller storefront bio, shown on the seller profile
  photo                 String? /// avatar URL (client uploads elsewhere, stores the URL here)
  isActive              Boolean              @default(true) /// false = login blocked (frozen by super admin)
  role                  UserRole             @default(BUYER)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sellerVerification    SellerVerification?
  products              Product[]            @relation("SellerProducts")
  buyerConversations    Conversation[]       @relation("BuyerConversations")
  sellerConversations   Conversation[]       @relation("SellerConversations")
  sentMessages          Message[]            @relation("SentMessages")
  supportTickets        SupportTicket[]
  supportMessagesSent   SupportMessage[]     @relation("SupportMessagesSent")
  reportsMade           Report[]             @relation("ReportsMade")
  reportsReceived       Report[]             @relation("ReportsReceived")
  passwordResets        PasswordReset[]
  aiConversations       AiConversation[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

/// @notice Seller ID verification (KTM). One user holds one active application.
/// @dev ktmImageUrl stores a private-storage URL, never expose it via /api/products.
/// @dev Flow: status PENDING -> action APPROVE/REJECT by admin -> status APPROVED/REJECTED.
/// @dev isActive is a separate active/non-active flag (an APPROVED seller can be frozen again after a fraud report).
model SellerVerification {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  namaLengkap     String /// name as printed on KTM, for audit (may differ from User.name display)
  nim             String             @unique
  universitas     String
  programStudi    String
  ktmImageUrl     String /// KTM photo, private — admin only
  status          VerificationStatus @default(PENDING)
  isActive        Boolean            @default(true) /// active/non-active flag: false = frozen, cannot sell
  action          VerificationAction @default(NONE) /// APPROVE | REJECT by admin (executed in service/admin)
  actionNote      String? /// approve/reject reason
  reviewedBy      String? /// deciding admin id. Opaque audit field, NOT a users FK: the deciding admin may be an `admins` (dashboard) row, whose id namespace is disjoint from `users`. Enforcing a FK here made the entire review path 500 with P2003.
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([isActive])
  @@map("seller_verifications")
}

/// @notice Student second-hand catalog. Seller = User with role SELLER.
/// @dev location is set by the seller when creating the catalog (default pickup point).
model Product {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String         @db.Text
  price         Int /// rupiah, >= 0 (validated in service/zod later)
  stock         Int            @default(1) /// quantities / stock
  imageUrls     String[]       @default([]) /// Image: 1..N URL, cover = imageUrls[0]
  category      String? /// TODO: become a Category FK — blank for now
  latitude      Float? /// item location, set when creating the catalog
  longitude     Float?
  locationLabel String? /// location label, e.g. boarding-house / campus area
  status        ProductStatus  @default(ACTIVE)
  soldAt        DateTime? /// filled when status flips to SOLD, so sales can be bucketed by date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  reports       Report[]
  events        ProductEvent[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([sellerId, status])
  @@index([sellerId, soldAt])
  @@index([status, createdAt])
  @@map("products")
}

/// @notice One analytics event on a product (seller dashboard numbers).
/// @dev Rows are append-only and never exposed publicly; the seller reads
/// @dev aggregated counts via /api/analytics, never these rows.
/// @dev viewerId is a plain TEXT (no FK): deleting a viewer must not delete
/// @dev the seller's historical numbers, and the viewer may be anonymous.
/// @dev source names the surface that produced the event (feed, search, share).
model ProductEvent {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductEventType
  viewerId  String? /// null = anonymous, otherwise the browsing user id
  source    String           @default("unknown") /// feed | search | share | detail
  createdAt DateTime         @default(now())

  @@index([productId, type, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@map("product_events")
}

/// @notice COD chat room per product: 1 buyer x 1 product = 1 room.
/// @dev Transactions happen off-system (direct COD); chat is only the bridge + history.
/// @dev The final COD point is agreed in chat (agreed*) — defaults to the product location.
model Conversation {
  id                  String    @id @default(cuid())
  productId           String? /// bargained product context, null = general chat; SetNull keeps history when the product is deleted
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyerId             String
  buyer               User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  agreedLatitude      Float? /// COD point agreed in the conversation (null = follow the product location)
  agreedLongitude     Float?
  agreedLocationLabel String? /// final COD point label
  lastMessageAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  messages            Message[]

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@map("conversations")
}

/// @notice One chat bubble. Content depends on type: TEXT->text, IMAGE->imageUrl, LOCATION->lat/lng + label.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)
  text           String?      @db.Text
  imageUrl       String?
  latitude       Float?
  longitude      Float?
  locationLabel  String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// @notice User -> support help ticket. Name/username resolve via the user relation (no duplication).
/// @dev The admin dashboard lists these tickets, then opens the conversation (SupportMessage) with the person concerned.
model SupportTicket {
  id            String                @id @default(cuid())
  ticketNo      String                @unique /// display number, e.g. KSP-20260928-A1B2 (generated in service)
  userId        String /// reporter
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      SupportTicketCategory @default(LAINNYA)
  status        SupportTicketStatus   @default(ACTIVE)
  subject       String
  description   String                @db.Text /// initial complaint (context, not chat)
  lastMessageAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("support_tickets")
}

/// @notice One support chat bubble. Sender is the reporter (User) or an admin (role ADMIN).
/// @dev isInternal = admin-to-admin note, never show it to the reporter.
model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// @dev Nullable on purpose: a dashboard operator lives in `admins`, not
  /// @dev `users`, so a NOT NULL `users` FK here made every dashboard reply
  /// @dev fail with P2003. `senderRole` + `senderName` keep it attributable.
  senderId   String?
  sender     User?         @relation("SupportMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole String        @default("BUYER") /// role at send time: BUYER | ADMIN | SUPER_ADMIN
  senderName String? /// display-name snapshot, so a deleted sender stays readable
  text       String        @db.Text
  imageUrl   String? /// screenshot / evidence, optional
  isInternal Boolean       @default(false)
  isRead     Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([senderId])
  @@map("support_messages")
}

/// @notice Catalog fraud report (Report button in the UI).
/// @dev At least one target is filled: reportedProductId (listing) and/or reportedUserId (fraud/reported). Validated in service.
model Report {
  id                String         @id @default(cuid())
  reportNo          String         @unique /// display number, e.g. RPT-20260928-A1B2 (generated in service)
  reporterId        String /// reporter
  reporter          User           @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId    String? /// reported person (fraud), null = reporting a listing only
  reportedUser      User?          @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedProductId String? /// reported listing, null = reporting a user only
  reportedProduct   Product?       @relation(fields: [reportedProductId], references: [id], onDelete: SetNull)
  category          ReportCategory @default(LAINNYA)
  description       String         @db.Text /// report detail from the UI
  evidenceUrls      String[]       @default([]) /// screenshots / chat evidence, optional
  status            ReportStatus   @default(PENDING)
  action            ReportAction   @default(NONE) /// WARNING | DELETE_PRODUCT | BAN_USER (executed in service/admin)
  actionNote        String? /// admin action reason
  reviewedBy        String? /// handling admin id. Opaque audit field, NOT a users FK — see SellerVerification.reviewedBy.
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reportedProductId])
  @@index([status])
  @@index([category])
  @@map("reports")
}

/// @notice Dashboard admin account. Separate from users (dashboard vs marketplace sessions never mix).
/// @dev Dashboard login uses email + passwordHash. One admin per row, disable via isActive.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true) /// false = dashboard access revoked
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

/// @notice 4-digit OTP for password changes via email verification.
/// @dev The code is stored as a hash (never plain), single-use, expires in ~10 minutes.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String /// destination email snapshot (fast lookup)
  codeHash   String /// 4-digit code hash, never plain
  expiresAt  DateTime /// e.g. now + 10 minutes
  attempts   Int       @default(0) /// wrong inputs counted, locked after 5x
  consumedAt DateTime? /// filled = already used, cannot be reused
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@map("password_resets")
}

/// @notice Per-user notification (in-app inbox).
/// @dev Rows are created by services on key events (chat, verification,
/// @dev reports, support) only when the matching preference is enabled.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String /// event group: chat | verification | reports | support | product | system
  title     String
  body      String   @db.Text
  data      Json? /// deep-link payload, e.g. { conversationId, productId }
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// @notice Per-user notification toggle. Missing row = enabled (opt-out model).
model NotificationPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String /// one of chat | verification | reports | support | product | system
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("notification_preferences")
}

/// @notice Sender role inside an AI chat session.
enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// @notice AI chat session between a user and the AI. Resumable — reopen and continue anytime.
/// @dev Title is auto-filled from the first message and editable afterwards.
model AiConversation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String /// session title, shown in the history list
  lastMessageAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  messages      AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// @notice One message inside an AI chat session (human or AI side).
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole  @default(USER)
  content        String         @db.Text
  model          String? /// AI model used for ASSISTANT messages, must match AiModel.modelId for cost tracking
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// @notice AI model registry. Admins add models here; chat uses AiModel.modelId.
/// @dev Prices in USD per 1M tokens. Disable = isActive false (hidden from picker, history kept).
model AiModel {
  id             String   @id @default(cuid())
  modelId        String   @unique /// code used in app, e.g. muse-spark-1.3
  name           String /// display name, e.g. Muse Spark 1.3
  inputPrice     Float /// USD per 1M input tokens
  outputPrice    Float /// USD per 1M output tokens
  cacheReadPrice Float    @default(0) /// USD per 1M cache-read tokens
  isActive       Boolean  @default(true) /// false = disabled, cannot be selected for new chats
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@map("ai_models")
}
