{
  "name": "kosply-db",
  "version": "0.1.0",
  "description": "Kosply DB - MariaDB schema, migrations and data layer for the marketplace",
  "scripts": {
    "migrate:deploy": "node src/cli.js deploy",
    "migrate:status": "node src/cli.js status",
    "migrate:reset": "node src/cli.js reset",
    "drift": "node ../scripts/db/schema-diff.sh check",
    "validate": "node src/cli.js validate",
    "seed": "node schema/seed.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.15.4"
  },
  "engines": {
    "node": ">=18"
  }
}