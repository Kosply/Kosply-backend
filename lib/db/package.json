{
  "name": "kosply-db",
  "version": "0.1.0",
  "description": "Kosply DB - Prisma schema + client for MariaDB (User, SellerVerification, Product)",
  "scripts": {
    "generate": "prisma generate --schema schema/schema.db",
    "migrate:deploy": "prisma migrate deploy --schema schema/schema.db",
    "studio": "prisma studio --schema schema/schema.db",
    "validate": "prisma validate --schema schema/schema.db",
    "format": "prisma format --schema schema/schema.db",
    "seed": "node schema/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^6.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
