{
  "name": "kosply-backend",
  "version": "0.1.0",
  "description": "Kosply Backend - Express + PM2 scaffold",
  "main": "lib/server/server.js",
  "scripts": {
    "dev": "node --watch lib/server/server.js",
    "dev:staging": "NODE_ENV=staging PORT=3001 node --watch lib/server/server.js",
    "start": "node lib/server/server.js",
    "start:staging": "NODE_ENV=staging PORT=3001 node lib/server/server.js",
    "start:live": "NODE_ENV=production PORT=3000 node lib/server/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:staging": "pm2 start ecosystem.config.js --only kosply-server-staging",
    "pm2:start:live": "pm2 start ecosystem.config.js --only kosply-server-live",
    "pm2:stop": "pm2 stop kosply-server-staging kosply-server-live",
    "pm2:stop:staging": "pm2 stop kosply-server-staging",
    "pm2:stop:live": "pm2 stop kosply-server-live",
    "pm2:restart": "pm2 restart kosply-server-staging kosply-server-live",
    "pm2:restart:staging": "pm2 restart kosply-server-staging",
    "pm2:restart:live": "pm2 restart kosply-server-live",
    "pm2:logs": "pm2 logs kosply-server-staging kosply-server-live",
    "pm2:logs:staging": "pm2 logs kosply-server-staging",
    "pm2:logs:live": "pm2 logs kosply-server-live"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
