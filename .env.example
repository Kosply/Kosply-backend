# LOCAL development (npm run dev / npm start)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
DATABASE_URL="mysql://kosply:CHANGE_ME@localhost:3306/kosply_dev?connection_limit=12&pool_timeout=20&connect_timeout=10"

# --- Secrets: generate, never copy a value from here ------------------------
# openssl rand -base64 48
#
# JWT_SECRET signs every user and admin token. A production boot with this
# unset, or set to the old `dev-only-secret` value, now FAILS FAST rather than
# signing tokens with a value published in this repository (which was a total
# authentication bypass: anyone could mint a SUPER_ADMIN token).
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# Session renewal. `POST /api/auth/refresh` exchanges a refresh token for a new
# access token, and `POST /api/auth/logout` ends the session — the only two ways
# to end a session before the access token's own expiry.
#
# REFRESH_TOKEN_TTL_DAYS is how long a session can be renewed WITHOUT the user
# being present, so it is the number that matters for a stolen session. It is
# clamped to 1..365; anything above a year is a permanent grant, which is what
# revocation is for.
REFRESH_TOKEN_TTL_DAYS="30"

# HMAC key applied to a refresh token before it is stored. Only the HMAC is
# written, so a database dump is useless without this. Separate from
# JWT_SECRET so rotating one does not silently kill every open session; falls
# back to JWT_SECRET when unset.
REFRESH_TOKEN_SECRET="

# INTERNAL_API_KEY guards /api/internal/*, the machine API the AI agent calls.
# Those routes were previously unauthenticated while the agent was reachable on
# 0.0.0.0:8000, which exposed COD transcripts and allowed posting chat messages
# as either party. Unset = the internal API refuses everything (fail closed).
# openssl rand -base64 32
INTERNAL_API_KEY=""

# MariaDB bootstrap, used by docker-compose on first start of an empty volume.
# init.sh also grants the app role access to kosply_staging / kosply_main and
# creates the agent role below. Rotating a password on a LIVE volume needs a
# manual ALTER USER.
MARIADB_ROOT_PASSWORD=""
MARIADB_USER=kosply
MARIADB_PASSWORD=""
MARIADB_DATABASE=kosply_dev
# Least-privilege role for the AI agent (see lib/db/docker/init.sh). It only
# needs the checkpoint tables and the ai_* history mirror, in kosply_agent.
AGENT_DB_PASSWORD=""

# Direct social auth (no vendor): Google + Apple client ids (comma-separated)
GOOGLE_CLIENT_IDS=""
APPLE_CLIENT_IDS=""
# Provider switches. Both default OFF outside development. Parsed against an
# explicit truthy set, so 0/off/no/FALSE all mean disabled.
# GOOGLE_LOGIN_ENABLED="true"
# APPLE_LOGIN_ENABLED="true"
# APPLE_JWKS_URL="https://appleid.apple.com/auth/keys"

# AI agent proxied by /api/ai/* (served separately, see docker-compose agent)
AI_AGENT_URL="http://localhost:8000"
# Agent-side LLM credentials (read by lib/agent, not by the server)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Number of reverse-proxy hops in front of the app. 0 when the app is directly
# exposed. Setting 1 without a real proxy made req.ip (and therefore the access
# log and the analytics dedupe key) fully client-controlled via
# X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Analytics window boundary. Minutes east of UTC that defines "today"; 420 = WIB.
# Never derived from the server's local clock, so the same query returns the
# same numbers on every host.
ANALYTICS_UTC_OFFSET_MINUTES=420

# --- Bootstrap admins (lib/db/schema/seed.js) -------------------------------
# The ONLY way to create the first dashboard admin / super admin. Bootstrap
# only: rotate after first use, and note that re-running the seed DOES rotate
# the password (it previously used `update: {}` and silently kept the old one).
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""            # minimum 12 characters
SUPERADMIN_SEED_EMAIL=""
SUPERADMIN_SEED_PASSWORD=""       # minimum 12 characters

# --- Dashboard demo seed (seed.sh) ------------------------------------------
# Operator account for local demos plus varied fixtures for every dashboard
# surface. Leave empty and seed.sh falls back to committed PLACEHOLDERS
# (admin@example.com / ChangeMe-…) — put your own values here (this file is
# gitignored), never in seed.sh.
SEED_ADMIN_EMAIL=""               # e.g. you@example.com
SEED_ADMIN_PASSWORD=""            # empty = generate one and print it once
SEED_ADMIN_NAME=""                # display name in the dashboard top bar

# --- STAGING (npm run start:staging) — test here first, port 3001 ----------
# Staging is a REAL deploy holding real data: it gets no stack traces, no dev
# OTP echo and the production access-log format.
# NODE_ENV=staging
# PORT=3001
# CORS_ORIGIN=https://staging.kosply.id

# --- MAIN runs via PM2 (ecosystem.config.js) -------------------------------
# Do not put production secrets here: PM2 writes its `env` block into
# ~/.pm2/dump.pm2, which `pm2 show` and `pm2 env` print. Export them in the
# shell (or a secret store) before starting; the launcher passes --update-env.
# NODE_ENV=production
# PORT=3000
# CORS_ORIGIN=https://app.kosply.id,https://admin.kosply.id
# JWT_SECRET=            # required; startup fails without it
# INTERNAL_API_KEY=      # required for the agent to reach /api/internal/*
# DATABASE_URL=          # optional override; defaults to the kosply_main URL
