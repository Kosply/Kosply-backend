# Kosply-backend - local development
#
#   cp .env.example .env
#
# These values match the docker compose MariaDB, so local dev runs as is.
# Setup:           https://github.com/Kosply/Kosply-backend#getting-started
# Every variable:  .env.full.example (production secrets, staging, AI, uploads)

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# "Web application" OAuth client id whose tokens POST /api/auth/google accepts.
# Same value as GOOGLE_SERVER_CLIENT_ID in Kosply-mobile/.env. Empty = no
# Google login. Create it at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_IDS=""

# local development (docker compose mariadb)
DATABASE_URL="mysql://kosply:kosply@localhost:3306/kosply_dev"
# Development only. Production refuses to boot with this JWT_SECRET; generate
# real values for both with `openssl rand -base64 48`.
JWT_SECRET="dev-only-secret"
INTERNAL_API_KEY="dev-internal-key"

# docker compose mariadb bootstrap (init.sh runs only on an empty volume)
MARIADB_ROOT_PASSWORD="kosply"
MARIADB_USER="kosply"
MARIADB_PASSWORD="kosply"
MARIADB_DATABASE="kosply_dev"
AGENT_DB_PASSWORD="kosply"

# Desktop OAuth client for Gmail send. Not the Android login client.
# Empty = no mail; development then returns the code as `devCode`.
#   1. Enable the Gmail API:
#        https://console.cloud.google.com/apis/library/gmail.googleapis.com
#   2. Create a "Desktop app" client:
#        https://console.cloud.google.com/apis/credentials
#   3. `node scripts/gmail-auth.js` writes GMAIL_REFRESH_TOKEN here for you.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER=""
