# LOCAL development (npm run dev / npm start)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
DATABASE_URL="postgresql://kosply:kosply@localhost:5432/kosply_dev?schema=public"
# Auth: set a strong random JWT_SECRET outside local dev
JWT_SECRET="dev-only-secret"
JWT_EXPIRES_IN="7d"
# AI agent proxied by /api/ai/* (served separately, see docker-compose agent)
AI_AGENT_URL="http://localhost:8000"

# STAGING (npm run start:staging) — test here first, port 3001
# NODE_ENV=staging
# PORT=3001

# MAIN runs via PM2 env (ecosystem.config.js), do not use .env directly
# NODE_ENV=production
# PORT=3000
